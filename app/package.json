{
  "name": "portionly",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean --platform android",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "check": "npm run test && npm run typecheck && expo export --platform android --output-dir .expo/export"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "expo": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-passkey": "3.6.1",
    "react-native-safe-area-context": "~5.8.1",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
